{
  "name": "rehabeat",
  "private": true,
  "version": "0.1.0",
  "description": "Rehab moves as a rhythm game: match the target pose to the beat on a webcam.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.tools.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:songs": "vitest run --config tools/songs/vitest.e2e.config.ts",
    "smoke": "node scripts/smoke.mjs",
    "songs": "tsx tools/songs/cli.ts"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@mediapipe/tasks-vision": "^1.2.3",
    "@supabase/supabase-js": "^2.119.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@clack/prompts": "^1.9.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "playwright": "^1.65.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
